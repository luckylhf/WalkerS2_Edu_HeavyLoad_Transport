<?xml version="1.0"?>
<package format="3">
  <name>box_grasp_demo</name>
  <version>0.1.0</version>
  <description>Point-cloud box detection and dual-arm grasp pose demo for Walker S2.</description>
  <maintainer email="hongfeng.long@ubtrobot.com">Walker S2 team</maintainer>
  <license>Apache-2.0</license>
  <license>LicenseRef-UBTECH-Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>action_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>box_grasp_demo_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <depend>std_msgs</depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>walker_s2_description</exec_depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- rosdep key; installs libmosquitto-dev, which provides libmosquitto.so.1 -->
  <exec_depend>mosquitto-dev</exec_depend>
  <exec_depend>python3-websocket</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
